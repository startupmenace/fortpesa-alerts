PORT=3000
# From Fortpesa dashboard > Settings & API keys (pb_live_...). Never commit .env.
FORTPESA_API_KEY=pb_live_xxx
# Integer id from the Channels page
FORTPESA_CHANNEL_ID=42
# Webhook signing secret (whsec_...)
FORTPESA_WEBHOOK_SECRET=whsec_xxx
# Secret token in the overlay URL: /overlay.html?token=...
OVERLAY_TOKEN=my-overlay-token
MIN_AMOUNT=10
# Set to 1 to enable POST /test/donate (local testing only)
ENABLE_TEST=1
